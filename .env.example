# ============================================================
# ScamShield — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your local values.
# NEVER commit .env — it contains real credentials.
# This file (.env.example) contains ONLY placeholders.
# ============================================================

# Application
APP_ENV=local
APP_DEBUG=false
APP_KEY=changeme_generate_a_random_32_char_key

# Database (MariaDB/MySQL via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scamshield
DB_USERNAME=scamshield_user
DB_PASSWORD=changeme_set_a_strong_password

# Evidence storage path (MUST be outside the public web root)
# Example Windows: C:\xampp\htdocs\AntiScam\storage\evidence
# This path is not web-accessible — see Docs/ARCHITECTURE.md
STORAGE_EVIDENCE_PATH=changeme_set_absolute_path_outside_webroot

# Logging
LOG_LEVEL=error
LOG_PATH=changeme_set_absolute_path_outside_webroot

# Threat intelligence (UNRESOLVED — do not set until provider is evaluated)
# See Docs/DECISION.md ADR-008
THREAT_INTEL_PROVIDER=none
THREAT_INTEL_API_KEY=not_configured

# Session
SESSION_NAME=scamshield_sess
SESSION_LIFETIME=1800
