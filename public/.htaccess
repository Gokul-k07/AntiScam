# ScamShield — public/.htaccess
# Requires: mod_rewrite (loaded in httpd.conf), AllowOverride All on this directory.
#
# Works under BOTH access patterns without modification:
#   (a) vhost root:  http://scamshield.local/      (DocumentRoot = AntiScam/public)
#   (b) subfolder:   http://localhost/AntiScam/public/  (DocumentRoot = htdocs)
#
# No RewriteBase is set. The rule target "index.php" is relative, so Apache
# resolves it to this directory's index.php in both cases.
# The Router reads SCRIPT_NAME to strip the subfolder prefix itself.

Options -Indexes

# ── Block dotfiles and sensitive path patterns ─────────────────────────────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── URL rewriting ──────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing static files and directories directly (assets, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else through the front controller.
    # Relative target (no leading /) works correctly under any DocumentRoot.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── Suppress PHP errors from reaching users ────────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>
