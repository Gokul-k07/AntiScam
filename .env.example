# ============================================================
# ScamShield — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your local values.
# NEVER commit .env — it contains real credentials.
# This file (.env.example) contains ONLY placeholders.
# ============================================================

# Application
APP_ENV=local
APP_DEBUG=false
APP_KEY=changeme_generate_a_random_32_char_key

# Database (MariaDB/MySQL via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scamshield
DB_USERNAME=scamshield_user
DB_PASSWORD=changeme_set_a_strong_password

# Evidence storage path (MUST be outside the public web root)
# Windows XAMPP example: C:\xampp\htdocs\AntiScam\storage\evidence
# This path is NOT web-accessible. See Docs/ARCHITECTURE.md §3.
STORAGE_EVIDENCE_PATH=changeme_set_absolute_path_to_storage_evidence

# Logging
LOG_LEVEL=error
LOG_PATH=changeme_set_absolute_path_to_storage_logs

# Session
SESSION_NAME=scamshield_sess
SESSION_LIFETIME=1800

# ── VirusTotal threat intelligence (optional) ────────────────────────────
# Set THREAT_INTEL_PROVIDER=virustotal to enable VirusTotal URL lookups.
# Leave as 'none' to run in local-heuristic-only mode (default).
#
# Obtain a free API key at: https://www.virustotal.com/gui/sign-in
# Public API limits: 4 requests/minute, 500 requests/day.
#
# SECURITY: Keep VIRUSTOTAL_API_KEY secret. Never commit it. Never log it.
THREAT_INTEL_PROVIDER=none
VIRUSTOTAL_API_KEY=not_configured

# Cache TTL in seconds for VirusTotal report results (default: 3600 = 1 hour).
# Increase to reduce API calls; decrease for fresher results.
VIRUSTOTAL_CACHE_TTL_SECONDS=3600
