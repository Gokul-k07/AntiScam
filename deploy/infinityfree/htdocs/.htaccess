# ==============================================================================
# ScamShield — Root .htaccess (InfinityFree Production Deployment)
# Target: https://scamshield.site.je
#
# InfinityFree compatibility rules:
#  - Options -Indexes is allowed; Options All / MultiViews are restricted.
#  - No nested <If> directives inside <FilesMatch> (causes Apache syntax 500).
#  - No php_flag / php_value directives (PHP runs via FastCGI/PHP-FPM).
#  - Security headers are emitted by PHP (Bootstrap.php) to prevent mod_headers failure.
#  - Access to app/, config/, database/, storage/ blocked via mod_rewrite + subfolder rules.
# ==============================================================================

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── 1. Force HTTPS ────────────────────────────────────────────────────────
    # InfinityFree load balancer terminates SSL; checks X-Forwarded-Proto,
    # HTTPS server var, and Cloudflare CF-Visitor headers to avoid redirect loops.
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:CF-Visitor} !{"scheme":"https"}
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ── 2. Block direct HTTP access to protected directories ─────────────────
    # Blocks requests to /app/, /config/, /database/, and /storage/ immediately.
    RewriteRule ^(app|config|database|storage)(/|$) - [F,L]

    # ── 3. Block dotfiles and hidden folders ─────────────────────────────────
    # Prevents direct access to .env, .git, .htaccess, etc.
    RewriteRule (^\.|/\.) - [F,L]

    # ── 4. Block direct access to sensitive file extensions ───────────────────
    RewriteRule \.(sql|log|env|json|lock|md|gitignore|example)$ - [F,L]

    # ── 5. Serve existing static assets directly (CSS, JS, images, favicon) ───
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Intercept missing favicon and robots to prevent waking up PHP / throwing 500
    RewriteRule ^favicon\.ico$ - [R=204,L]
    RewriteRule ^robots\.txt$ - [R=404,L]

    # ── 6. Front Controller dispatch for all application routes ───────────────
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ── Fallback file protections (in case mod_rewrite is bypassed) ───────────────
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|env|json|lock|md|gitignore|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
