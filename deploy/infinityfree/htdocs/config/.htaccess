# ScamShield — config/.htaccess
# CRITICAL: This directory contains credentials (.env) and configuration.
# All direct HTTP access is denied unconditionally.
# PHP can still require/include files here (open_basedir allows htdocs/).

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
