# ============================================================
# ScamShield — InfinityFree Production Environment Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to config/.env (same directory)
#   2. Fill in every value marked <CHANGE_THIS>
#   3. Upload via FTP — config/.htaccess denies HTTP access
#   4. NEVER commit config/.env to version control
#   5. NEVER paste credentials into Kiro chat or any public medium
#
# This file (config/.env.deploy.example) contains ONLY placeholders
# and is safe to include in the deploy package for reference.
# ============================================================

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
# Generate: php -r "echo bin2hex(random_bytes(16));"
APP_KEY=<CHANGE_THIS_32_hex_chars_random_key>

# ── Database (from InfinityFree control panel → MySQL Databases) ──────────
# Host is shown in the control panel (e.g. sql123.infinityfree.com)
DB_HOST=<CHANGE_THIS_from_cpanel>
DB_PORT=3306
DB_DATABASE=<CHANGE_THIS_database_name>
DB_USERNAME=<CHANGE_THIS_database_user>
DB_PASSWORD=<CHANGE_THIS_database_password>

# ── Storage paths (MUST be inside htdocs/ due to open_basedir) ────────────
# These values are absolute server paths.
# InfinityFree account path format: /home/vol{N}_{M}/infinityfree.com/{username}/htdocs
# Get your exact path from InfinityFree control panel → FTP Details
#
# Example (replace with your actual account path):
#   STORAGE_EVIDENCE_PATH=/home/vol1_1/infinityfree.com/if0_12345678/htdocs/storage/evidence
#   LOG_PATH=/home/vol1_1/infinityfree.com/if0_12345678/htdocs/storage/logs
#
STORAGE_EVIDENCE_PATH=<CHANGE_THIS_absolute_server_path>/storage/evidence
LOG_PATH=<CHANGE_THIS_absolute_server_path>/storage/logs

# ── Session ───────────────────────────────────────────────────────────────
SESSION_NAME=ss_prod
SESSION_LIFETIME=1800

# ── VirusTotal threat intelligence (optional) ─────────────────────────────
# Set THREAT_INTEL_PROVIDER=virustotal to enable VT URL lookups.
# Leave as 'none' to run in local-heuristic-only mode.
# Obtain a free API key at: https://www.virustotal.com/gui/sign-in
# SECURITY: Never commit this key. Never log it.
THREAT_INTEL_PROVIDER=none
VIRUSTOTAL_API_KEY=not_configured
VIRUSTOTAL_CACHE_TTL_SECONDS=3600
