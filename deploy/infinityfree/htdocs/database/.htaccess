# ScamShield — database/.htaccess
# Deny direct HTTP access to schema.sql and any SQL files.
# schema.sql must NEVER be downloadable via browser.
# Database setup is performed only via phpMyAdmin — not via web endpoint.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
